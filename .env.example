DATABASE_URL=postgresql://fitflow:fitflow_dev_password@localhost:5432/fitflow?schema=public

# openssl rand -base64 48 (32+ characters, no default — the app refuses to
# start without these; see src/lib/env.ts)
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=

JWT_ISSUER=fitflow-suite
JWT_AUDIENCE=fitflow-suite-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional, defaults to 7 (days). Only read by
# `npm run prune-refresh-tokens` (prisma/prune-refresh-tokens.ts), a
# standalone script meant to be run on a schedule, not by the app at
# request time — see the root README's Operations section.
REFRESH_TOKEN_PRUNE_GRACE_DAYS=7

PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API (the web
# dashboard in web/) — see src/lib/cors.ts. Non-browser clients (mobile
# apps, curl, server-to-server) are unaffected either way.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Unset (the default) means every rate limiter
# (src/rbac/rate-limit.middleware.ts) uses its own in-memory store —
# fine for local dev and a single API instance, but each replica would
# track its own separate counts if you ran more than one. Set this
# (e.g. redis://localhost:6379) to share rate-limit state across
# replicas via Redis instead — see src/lib/redis-client.ts.
REDIS_URL=

# Optional, defaults to 5 (attempts/hour/IP). Raise this only in a
# test/CI environment where many legitimate registrations share one IP
# (see .github/workflows/ci.yml's e2e job) — never in production, where
# 5/hour is the actual anti-abuse control.
REGISTER_RATE_LIMIT_MAX=
